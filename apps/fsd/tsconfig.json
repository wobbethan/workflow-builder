{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./old-workflow-builder/*",
        "./src/*"
      ],
      "@old-workflow-builder/*": [
        "./old-workflow-builder/*"
      ],
      "@workflow-builder/types/*": [
        "../types/src/*"
      ],
      "@/entities/*": [
        "./src/entities/*"
      ],
      "@/features/*": [
        "./src/features/*",
        "./old-workflow-builder/features/*"
      ],
      "@/page/*": [
        "./src/page/*"
      ],
      "@/shared/*": [
        "./src/shared/*"
      ],
      "@/ui/*": [
        "./src/shared/ui/*"
      ],
      "@/data/*": [
        "./src/shared/data/*"
      ],
      "@/utils/*": [
        "./src/shared/utils/*"
      ],
      "@/store/*": [
        "./src/shared/store/*"
      ],
      "@/widgets/*": [
        "./src/widgets/*"
      ]
    },
    "allowJs": true,
    "isolatedModules": true,
    "lib": ["dom", "dom.iterable", "es2022"]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "old-workflow-builder/**/*.ts",
    "old-workflow-builder/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "old-workflow-builder/**/*.spec.ts",
    "old-workflow-builder/**/*.test.ts",
    "old-workflow-builder/**/*.spec.tsx",
    "old-workflow-builder/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ]
}

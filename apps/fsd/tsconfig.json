{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/entities/*": ["./src/entities/*"],
      "@/features/*": ["./src/features/*"],
      "@/page/*": ["./src/page/*"],
      "@/shared/*": ["./src/shared/*"],
      "@/ui/*": ["./src/shared/ui/*"],
      "@/data/*": ["./src/shared/data/*"],
      "@/utils/*": ["./src/shared/utils/*"],
      "@/store/*": ["./src/shared/store/*"],
      "@/widgets/*": ["./src/widgets/*"]
    },
    "allowJs": true,
    "isolatedModules": true,
    "lib": ["dom", "dom.iterable", "es2022"]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ]
}

{
  "name": "workflow-builder",
  "version": "1.2.0",
  "private": true,
  "workspaces": ["apps/*"],
  "catalog": {
    "@phosphor-icons/core": "^2.1.1",
    "@xyflow/react": "12.10.0",
    "react": "^19.1.0",
    "@types/react": "19.1.8",
    "react-dom": "^19.1.0",
    "ajv": "^8.0.0"
  },
  "scripts": {
    "dev": "bun run --filter '@workflow-builder/frontend' dev",
    "dev:local": "LOCAL_OVERFLOW_UI=true bun run --filter '@workflow-builder/frontend' dev",
    "build": "bun run --filter './apps/*' build",
    "preview-build": "bun run --filter '@workflow-builder/frontend' preview-build",
    "typecheck": "bun run --filter './apps/*' typecheck",
    "lint": "bun run --filter './apps/*' lint",
    "lint:fix": "bun run --filter './apps/*' lint:fix",
    "build:frontend": "bun run --filter '@workflow-builder/frontend' build",
    "format": "prettier --write --log-level silent \"**/*.+(css|ts|tsx|json|md|mdx|astro)\"",
    "test": "bun run --filter '@workflow-builder/frontend' test",
    "check": "bun run lint && bun run typecheck && bun run format",
    "pre-commit": "lint-staged",
    "pre-push": "bun run format",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^22.12.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unicorn": "^59.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "knip": "^5.56.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.22.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.13"
}
